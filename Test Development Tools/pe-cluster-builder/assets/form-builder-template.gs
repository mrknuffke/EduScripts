/**
 * PE CLUSTER · Google Form + scoring spreadsheet builder
 * Generated by pe-cluster-builder/scripts/make_form_script.py from content.json.
 * Do not edit the SPEC block by hand: change content.json and regenerate, or the
 * scoring sheet .docx and this workbook will drift apart.
 *
 * Builds:
 *   1. The student-facing Google Form (quiz mode, one item per criterion)
 *   2. A linked scoring spreadsheet that auto-scores the selected-response criteria,
 *      accepts 0/1 entry for the constructed-response criteria, and rolls each bucket
 *      up to a 1-4 level using gates derived from each bucket's criterion count.
 *
 * HOW TO RUN
 *   script.google.com -> New project -> paste this file -> Save
 *   Upload the stimulus PNGs to Drive first, with the exact names in CONFIG.images.
 *   Run -> buildAssessment -> authorise when prompted.
 *   The execution log prints the Form edit URL, the live URL and the Sheet URL.
 *
 * Re-running creates a fresh Form and Sheet. It never modifies an existing one.
 *
 * DESIGN NOTES worth keeping when you edit this file
 *   - CRITERIA is the single source of truth. The scoring sheet .docx must be generated
 *     from the same source, or the two drift. That has happened before.
 *   - Answer keys live in the hidden _key sheet. Scoring formulas reference those cells,
 *     so re-wording an option in the Form means editing one cell, not 400 formulas.
 *   - Header cells that look like ranges are written as text. "1-4" left as a plain value
 *     is silently converted by Sheets into a date.
 *   - Quiz grade release cannot be set from Apps Script. Quizzes default to manual
 *     release, which is what we want. Do not add a config flag implying otherwise.
 */

/* ============================================================ *
 *  CONFIGURATION
 * ============================================================ */

/* >>> SPEC BEGIN (generated) */

var CONFIG = {
  pe: 'HS-PSx-x',
  formTitle: 'Unit x Assessment · <short context title>',
  sheetTitle: 'Unit x · Scoring (HS-PSx-x)',
  durationNote: 'Suggested time: 40 minutes.',
  collectEmails: true,      // false if students are not signed in

  /* Section 1 identity block. Teachers appear as a dropdown; edit this list per section
   * roster. The access code gates entry: change the codeword to re-open or close the
   * form without rebuilding it. Treat it as a soft gate on casual sharing, not as
   * security: the pattern travels with the published form and a determined student
